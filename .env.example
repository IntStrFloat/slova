# ── Backend (см. docs/specs/11,14) ───────────────────────────────────────────
# Изолированный backend Slova на общем сервере (НЕ bloxx): порт 8788, сабдомен slova.*
EXPO_PUBLIC_API_URL=https://slova.193.160.208.95.nip.io

# ── Реклама Yandex Mobile Ads (см. docs/specs/05) ─────────────────────────────
# Простая монетизация: public ID из письма менеджера. Debug всегда использует demo.
EXPO_PUBLIC_YANDEX_BANNER_AD_UNIT_ID=R-M-20249615-1
EXPO_PUBLIC_YANDEX_INTERSTITIAL_AD_UNIT_ID=R-M-20249615-3
EXPO_PUBLIC_YANDEX_REWARDED_AD_UNIT_ID=R-M-20249615-2
# Только для изолированной release-QA сборки; не включать при публикации.
EXPO_PUBLIC_YANDEX_TEST_ADS=0
# Для текущего RuStore-профиля не требуется (уточнение менеджера 21.10.2026).
# Опционально для отдельного согласованного Google-профиля; меняет native manifest.
YANDEX_ADS_GOOGLE_APP_ID=
# UAuth-токен кабинета Яндекса — НЕ EXPO_PUBLIC (в APK не попадает), только локально:
YANDEX_ADS_UAUTH_TOKEN=

# ── RuStore (см. docs/specs/05,11,12) ─────────────────────────────────────────
# Публичный projectId пушей RuStore (не секрет). Сервисный токен — только в консоли RuStore.
EXPO_PUBLIC_RUSTORE_PUSH_PROJECT_ID=
# consoleApplicationId для RuStore Billing (после регистрации приложения в RuStore Console)
EXPO_PUBLIC_RUSTORE_CONSOLE_APP_ID=

# ── Аналитика AppMetrica (см. docs/specs/16) ──────────────────────────────────
# UUID-ключ AppMetrica. Release prebuild требует валидный UUID по умолчанию.
APPMETRICA_API_KEY=
# Чтобы намеренно собрать без аналитики: оставьте APPMETRICA_API_KEY пустым
# и задайте APPMETRICA_REQUIRED=0. Непустой ключ этот флаг не отключает.
# Пустой ключ заменяет прежний BuildConfig key; native SDK остаётся выключенным.
APPMETRICA_REQUIRED=1

# RuStore Remote Config: optional, local control by default; no project is created automatically.
EXPO_PUBLIC_RUSTORE_REMOTE_CONFIG_ENABLED=0
RUSTORE_REMOTE_CONFIG_APP_ID=
