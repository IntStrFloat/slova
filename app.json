{
  "expo": {
    "name": "Слова: Игра в слова",
    "slug": "slova",
    "version": "0.1.14",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "slova",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#101826",
    "android": {
      "package": "com.intstrfloat.slova",
      "versionCode": 18,
      "adaptiveIcon": {
        "backgroundColor": "#101826",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#101826",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160
        }
      ],
      [
        "expo-audio",
        {
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ],
      "expo-localization",
      "expo-asset",
      "./plugins/withAndroidResourceFallbacks",
      "./plugins/withAppMetrica",
      "./plugins/withYandexMediationVk",
      "./plugins/withRuStorePush",
      "./plugins/withRuStoreReview"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
