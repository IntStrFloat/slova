# /opt/slova/backend.env (на сервере, вне git, chmod 600)
PORT=8788
DATA_PATH=/var/lib/slova/store.json
# Separate from profile/progress data; raw reported words are retained here for 180 days.
MODERATION_DATA_PATH=/var/lib/slova/moderation.json
# Generate once per release: node backend/scripts/build-content-catalog.cjs --output /opt/slova/content-catalog-v1.json
# The generator refuses to overwrite a prior release; point this variable at the new file.
# Metadata only, including intro-v1; required before word reports are enabled.
CONTENT_CATALOG_PATH=/opt/slova/content-catalog-v1.json
# Set only after smoke testing the corresponding endpoint.
FEATURE_REMOTE_WORD_POLICY=0
FEATURE_WORD_REPORTS=0
# Set to 1 only behind the managed nginx proxy, so X-Forwarded-For is trusted for report limits.
TRUST_PROXY=0
API_KEY=

# Robokassa: server only. Never copy passwords into EXPO_PUBLIC_* or the app.
# Safe preparation: node scripts/prepare-subscription-deploy.cjs --mode test
# Live preparation is separate: --mode live (includes Password3 for refunds).
# The installer always keeps sales and the three confirmation gates disabled.
BILLING_PROVIDER=robokassa
BILLING_ENABLED=0
BILLING_MODE=test
BILLING_PUBLIC_BASE=https://slova.193.160.208.95.nip.io
# Provider + merchant + mode have independent ledgers. Never import old YooKassa
# payment IDs, saved methods, subscriptions, or notices into these files.
# For live use billing-robokassa-slova-live.json and the matching notices path.
BILLING_DATA_PATH=/var/lib/slova/billing-robokassa-slova-test.json
BILLING_NOTICES_DATA_PATH=/var/lib/slova/renewal-notices-robokassa-slova-test.json
# Read-only migration evidence; no journal IDs or entitlements are imported.
# TEST installer defaults to []; LIVE defaults to the exact same-merchant TEST
# journal shown below. A missing/corrupt source leaves the draft unresolved.
BILLING_RETIRED_JOURNALS=[]
# LIVE: BILLING_RETIRED_JOURNALS=[{"provider":"robokassa","path":"/var/lib/slova/billing-robokassa-slova-test.json"}]
# Operator-only exact-draft approvals: directory root:slova 0750, file
# root:slova 0640. Service may read, never write. Missing file means no approvals.
# Installer creates the directory if absent; an existing unsafe directory fails.
# Local operator CLI: node scripts/approve-billing-migration.cjs /private/review.json
BILLING_MIGRATION_RESOLUTIONS_PATH=/etc/slova/billing-migration-resolutions.json
ROBOKASSA_MERCHANT_LOGIN=slova
ROBOKASSA_HASH_ALGORITHM=SHA256
# Distinct pairs from the matching tabs in the Robokassa cabinet; no fallback
# between test and live. Password3 is used only by authenticated live refunds.
ROBOKASSA_TEST_PASSWORD1=
ROBOKASSA_TEST_PASSWORD2=
ROBOKASSA_PASSWORD1=
ROBOKASSA_PASSWORD2=
ROBOKASSA_PASSWORD3=
# Confirm only after the corresponding cabinet / My Tax evidence is verified.
# A saved password alone does not prove merchant activation, recurring access,
# or approved fiscalization. Keep SMZ=0 while My Tax authorization is pending.
ROBOKASSA_MERCHANT_CONFIRMED=0
ROBOKASSA_RECURRING_CONFIRMED=0
ROBOKASSA_SMZ_CONFIRMED=0
BILLING_LIVE_READY=0
# Retain pre-existing YOOKASSA_* variables and old ledger files only as legacy
# records during migration; the preparation script leaves them unchanged.
# Updated clients send X-Slova-Billing-Protocol: robokassa-v3. Old clients stay
# unavailable; check both forms of the catalog after every deployment.
# Optional local credentials/robokassa-seller.env accepts only these two fields.
# When that file is absent the installer preserves the server's existing values.
BILLING_SELLER_NAME=
BILLING_SELLER_INN=
BILLING_SUPPORT_EMAIL=sales@strsoft.ru

# Optional LIVE renewal notices via the existing Timeweb mailbox, server only.
# Fixed smtp.timeweb.ru:465, verified TLS; no custom host/port or dependencies.
# The sender address must match TIMEWEB_MAIL_USERNAME; display name is optional.
# Test mode never sends through this live transport. Ambiguous SMTP acceptance
# requires manual reconciliation; a stable Message-ID does not allow retries.
BILLING_NOTICE_PROVIDER=timeweb
BILLING_NOTICE_SENDER=Слова <sales@strsoft.ru>
TIMEWEB_MAIL_USERNAME=sales@strsoft.ru
TIMEWEB_MAIL_PASSWORD=

# Verified billing lifecycle exports through AppMetrica Post API. The SDK API key
# is NOT a Post API key. Keep disabled until the dedicated server key is supplied
# locally and consent/identity binding has been verified. No retrospective rebind.
APPMETRICA_SERVER_EVENTS_ENABLED=0
APPMETRICA_APPLICATION_ID=6321823
APPMETRICA_POST_API_KEY=
