# /opt/slova/backend.env (на сервере, вне git, chmod 600)
PORT=8788
DATA_PATH=/var/lib/slova/store.json
# Separate from profile/progress data; raw reported words are retained here for 180 days.
MODERATION_DATA_PATH=/var/lib/slova/moderation.json
# Generate once per release: node backend/scripts/build-content-catalog.cjs --output /opt/slova/content-catalog-v1.json
# The generator refuses to overwrite a prior release; point this variable at the new file.
# Metadata only, including intro-v1; required before word reports are enabled.
CONTENT_CATALOG_PATH=/opt/slova/content-catalog-v1.json
# Set only after smoke testing the corresponding endpoint.
FEATURE_REMOTE_WORD_POLICY=0
FEATURE_WORD_REPORTS=0
# Set to 1 only behind the managed nginx proxy, so X-Forwarded-For is trusted for report limits.
TRUST_PROXY=0
API_KEY=

# YooKassa: server only. Never copy these secrets into EXPO_PUBLIC_*.
BILLING_ENABLED=0
BILLING_MODE=test
BILLING_PUBLIC_BASE=https://slova.193.160.208.95.nip.io
BILLING_DATA_PATH=/var/lib/slova/billing.json
# Strict, durable notice journal; keep separate from billing/progress files.
BILLING_NOTICES_DATA_PATH=/var/lib/slova/renewal-notices.json
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Enable live only after the game store/recurring payments, seller terms,
# renewal notices and the NPD receipt process have all been configured.
BILLING_LIVE_READY=0
# No readiness flag enables NPD receipts. Live sales remain disabled until
# a real fiscal API adapter is implemented and configured in backend startup.
BILLING_SELLER_NAME=
BILLING_SELLER_INN=
BILLING_SUPPORT_EMAIL=sales@strsoft.ru

# Optional LIVE renewal notices via the existing Timeweb mailbox, server only.
# Fixed smtp.timeweb.ru:465, verified TLS; no custom host/port or dependencies.
# The sender address must match TIMEWEB_MAIL_USERNAME; display name is optional.
# Test mode never sends through this live transport. Ambiguous SMTP acceptance
# requires manual reconciliation; a stable Message-ID does not allow retries.
BILLING_NOTICE_PROVIDER=timeweb
BILLING_NOTICE_SENDER=Слова <sales@strsoft.ru>
TIMEWEB_MAIL_USERNAME=sales@strsoft.ru
TIMEWEB_MAIL_PASSWORD=
