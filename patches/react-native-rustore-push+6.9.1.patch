+package com.rustorepush
+
+import android.content.Context
+import android.content.Intent
+import android.os.Build
+import com.facebook.react.bridge.WritableMap
+import com.facebook.react.bridge.WritableNativeMap
+import org.json.JSONArray
+import org.json.JSONObject
+import ru.rustore.sdk.pushclient.messaging.model.RemoteMessage
+import java.security.MessageDigest
+
+/** Only audited routing fields survive JS/process recreation. Never persist text, raw data or tokens. */
+internal object SlovaPushState {
+  private const val PREFS = "slova.push.delivery.v1"
+  private const val CACHE = "routing"
+  private val fields = listOf("route", "campaign_id", "min_version_code", "min_content_levels", "sender_admission_id")
+  private fun prefs(context: Context) = context.getSharedPreferences(PREFS, Context.MODE_PRIVATE)
+  /** Native package capability: independent of the mutable JS/OTA manifest and of Push consent. */
+  @Suppress("DEPRECATION")
+  fun nativeVersionCode(context: Context): Double = try {
+    val info = context.packageManager.getPackageInfo(context.packageName, 0)
+    val code = if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.P) info.longVersionCode else info.versionCode.toLong()
+    if (code in 1..Int.MAX_VALUE.toLong()) code.toDouble() else 0.0
+  } catch (_: Exception) { 0.0 }
+  fun enabled(context: Context): Boolean = prefs(context).getBoolean("enabled", false)
+  fun owner(context: Context): String = prefs(context).getString("owner", "") ?: ""
+  fun epoch(context: Context): Long = prefs(context).getLong("epoch", 0)
+  @Synchronized fun setContext(context: Context, enabled: Boolean, owner: String) {
+    val pref = prefs(context)
+    val edit = pref.edit().putBoolean("enabled", enabled).putString("owner", owner.take(96))
+    if (pref.getBoolean("enabled", false) != enabled || pref.getString("owner", "") != owner) edit.putLong("epoch", epoch(context) + 1)
+    if (!enabled || pref.getString("owner", "") != owner) edit.remove(CACHE).remove("pendingOpenedId").remove("pendingOpenedAt")
+    edit.commit()
+  }
+  private fun entries(context: Context): List<JSONObject> = try {
+    val array = JSONArray(prefs(context).getString(CACHE, "[]") ?: "[]")
+    (0 until minOf(array.length(), 32)).mapNotNull { array.optJSONObject(it) }.filter {
+      it.optString("ownerScope") == prefs(context).getString("owner", "") &&
+        System.currentTimeMillis() - it.optLong("receivedAtMs") in 0..30L * 24 * 60 * 60 * 1000
+    }
+  } catch (_: Exception) { emptyList() }
+  private fun map(entry: JSONObject): WritableMap = WritableNativeMap().apply {
+    putString("messageId", entry.optString("messageId"))
+    putString("ownerScope", entry.optString("ownerScope"))
+    putDouble("receivedAtMs", entry.optLong("receivedAtMs").toDouble())
+    if (entry.has("openedAtMs")) putDouble("openedAtMs", entry.optLong("openedAtMs").toDouble())
+    val data = entry.optJSONObject("data") ?: JSONObject()
+    putMap("data", WritableNativeMap().apply { fields.forEach { if (data.has(it)) putString(it, data.optString(it)) } })
+  }
+  @Synchronized fun remember(context: Context, message: RemoteMessage): JSONObject? {
+    if (!enabled(context)) return null
+    val id = message.messageId?.takeIf { it.isNotEmpty() && it.length <= 192 } ?: return null
+    val current = entries(context)
+    current.find { it.optString("messageId") == id }?.let { return it }
+    val data = JSONObject()
+    fields.forEach { key -> message.data[key]?.takeIf { it.length <= 512 }?.let { data.put(key, it) } }
+    if (message.notification?.clickActionType?.name == "DEEP_LINK") {
+      message.notification?.clickAction?.takeIf { it.length <= 128 }?.let { data.put("route", it) }
+    }
+    val item = JSONObject().put("messageId", id).put("ownerScope", prefs(context).getString("owner", ""))
+      .put("receivedAtMs", System.currentTimeMillis()).put("data", data)
+    val saved = JSONArray(); (current.takeLast(31) + item).forEach { saved.put(it) }
+    return if (prefs(context).edit().putString(CACHE, saved.toString()).commit()) item else null
+  }
+  fun cache(context: Context, message: RemoteMessage): WritableMap? = remember(context, message)?.let { map(it) }
+  @Synchronized fun initialEntry(context: Context, intent: Intent?): JSONObject? {
+    if (!enabled(context)) return null
+    val pref = prefs(context)
+    val id = intent?.getStringExtra("vkpns.analytics_payload.message_id") ?: pref.getString("pendingOpenedId", null) ?: return null
+    val openedAt = intent?.getLongExtra("slovaNotificationOpenedAtMs", pref.getLong("pendingOpenedAt", System.currentTimeMillis()))
+      ?: pref.getLong("pendingOpenedAt", System.currentTimeMillis())
+    return entries(context).find { it.optString("messageId") == id }?.let {
+      JSONObject(it.toString()).put("openedAtMs", openedAt.takeIf { value -> value in 0..9_007_199_254_740_991L } ?: System.currentTimeMillis())
+    }
+  }
+  fun initial(context: Context, intent: Intent?): WritableMap? = initialEntry(context, intent)?.let { map(it) }
+  @Synchronized fun acknowledgeOpen(context: Context, id: String) {
+    if (prefs(context).getString("pendingOpenedId", null) == id) {
+      prefs(context).edit().remove("pendingOpenedId").remove("pendingOpenedAt").commit()
+    }
+  }
+  fun receipt(context: Context, message: RemoteMessage) {
+    if (message.notification == null) return // Silent data updates are not automatically displayed notifications.
+    val admission = message.data["sender_admission_id"]?.takeIf { Regex("[a-f0-9]{32}").matches(it) }
+    val id = admission ?: MessageDigest.getInstance("SHA-256").digest(
+      (message.messageId?.take(192) ?: "missing:${System.currentTimeMillis() / 86_400_000}").toByteArray(),
+    ).joinToString("") { "%02x".format(it) }.take(32)
+    context.sendBroadcast(Intent().setClassName(context.packageName, "expo.modules.reminders.RemotePushReceiptReceiver")
+      .putExtra("notificationId", "remote_$id"))
+  }
+}
