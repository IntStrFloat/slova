+package com.rustorepush
+
+import java.util.ArrayDeque
+import java.util.concurrent.atomic.AtomicBoolean
+
+/** One actual SDK-operation lifetime across React contexts; a JS deadline cannot release this queue. */
+internal object SlovaPushOperations {
+  private val pending = ArrayDeque<(complete: () -> Unit) -> Unit>()
+  private var running = false
+
+  fun enqueue(operation: (complete: () -> Unit) -> Unit) {
+    val start = synchronized(this) {
+      pending.addLast(operation)
+      if (running) false else { running = true; true }
+    }
+    if (start) next()
+  }
+
+  private fun next() {
+    val operation = synchronized(this) {
+      pending.pollFirst().also { if (it == null) running = false }
+    } ?: return
+    val finished = AtomicBoolean(false)
+    val complete = { if (finished.compareAndSet(false, true)) next() }
+    try { operation(complete) } catch (_: Exception) { complete() }
+  }
+}
