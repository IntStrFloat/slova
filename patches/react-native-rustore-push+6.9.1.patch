@@ -0,0 +1,79 @@
+package com.rustorepush
+
+import android.app.Activity
+import android.app.Instrumentation
+import android.content.Context
+import android.content.Intent
+import android.os.Bundle
+import android.os.Build
+import ru.rustore.sdk.pushclient.messaging.model.RemoteMessage
+
+/** Local policy/cache/actual native queue tests only. Never initializes or sends through the SDK. */
+class PushReliabilityTestRunner : Instrumentation() {
+  override fun onCreate(arguments: Bundle?) { super.onCreate(arguments); start() }
+  override fun onStart() {
+    val passed = mutableListOf<String>()
+    try {
+      check(context.packageName.endsWith(".test")) { "Requires isolated library test package" }
+      val info = context.packageManager.getPackageInfo(context.packageName, 0)
+      @Suppress("DEPRECATION")
+      val actualVersion = if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.P) info.longVersionCode else info.versionCode.toLong()
+      check(SlovaPushState.nativeVersionCode(context) == actualVersion.toDouble())
+      passed.add("actual_installed_package_version_without_js_manifest")
+      val prefs = context.getSharedPreferences("slova.push.delivery.v1", Context.MODE_PRIVATE)
+      prefs.edit().clear().commit()
+      SlovaPushState.setContext(context, true, "qa-owner")
+      val epoch = SlovaPushState.epoch(context)
+      val message = RemoteMessage("native-message", 1, 3600, "test", null,
+        mapOf("route" to "/daily", "campaign_id" to "daily-reminder-v1", "auth_token" to "private-secret"),
+        "private-raw-data".toByteArray(), null)
+      val entry = requireNotNull(SlovaPushState.remember(context, message))
+      check(!entry.toString().contains("private"))
+      check(entry.getJSONObject("data").length() == 2)
+      passed.add("sanitized_durable_routing_cache")
+
+      val at = System.currentTimeMillis()
+      val warm = Intent().putExtra("vkpns.analytics_payload.message_id", "native-message")
+        .putExtra("slovaNotificationOpenedAtMs", at)
+      // MainActivity sets its sanitized intent before Expo/RN can drop an early callback.
+      lateinit var activity: Activity
+      runOnMainSync { activity = Activity().apply { intent = warm } }
+      val restoredContext = context.createPackageContext(context.packageName, 0)
+      val restored = requireNotNull(SlovaPushState.initialEntry(restoredContext, activity.intent))
+      check(restored.getString("messageId") == "native-message" && restored.getLong("openedAtMs") == at)
+      passed.add("warm_intent_before_js_recovers_from_current_activity")
+      prefs.edit().putString("pendingOpenedId", "native-message").putLong("pendingOpenedAt", at).commit()
+      check(SlovaPushState.initialEntry(restoredContext, Intent())?.getString("messageId") == "native-message")
+      SlovaPushState.acknowledgeOpen(restoredContext, "native-message")
+      check(SlovaPushState.initialEntry(restoredContext, Intent()) == null)
+      passed.add("opened_journal_fallback_and_ack")
+
+      SlovaPushState.setContext(context, true, "other-owner")
+      check(SlovaPushState.epoch(context) != epoch && SlovaPushState.initialEntry(context, warm) == null)
+      SlovaPushState.setContext(context, false, "other-owner")
+      check(SlovaPushState.remember(context, message) == null)
+      passed.add("owner_epoch_and_refusal_clear_routing")
+
+      val order = mutableListOf<String>()
+      var firstComplete: (() -> Unit)? = null
+      var nextComplete: (() -> Unit)? = null
+      var subscribed = false
+      SlovaPushOperations.enqueue { complete -> order.add("subscribe_started"); firstComplete = complete }
+      SlovaPushOperations.enqueue { complete -> subscribed = false; order.add("deleted"); complete() }
+      SlovaPushOperations.enqueue { complete -> order.add("next_owner"); nextComplete = complete }
+      SlovaPushOperations.enqueue { complete -> order.add("last"); complete() }
+      check(order == listOf("subscribe_started")) { "Actual transport lifetime must hold ownership" }
+      subscribed = true // Late SDK success, after the public JS deadline and opt-out.
+      requireNotNull(firstComplete).invoke()
+      check(!subscribed && order == listOf("subscribe_started", "deleted", "next_owner"))
+      firstComplete?.invoke()
+      check(order.last() == "next_owner") { "Stale completion cannot release the next owner's operation" }
+      requireNotNull(nextComplete).invoke()
+      check(order.last() == "last")
+      passed.add("actual_transport_fifo_and_stale_completion_guard")
+      finish(Activity.RESULT_OK, Bundle().apply { putInt("tests_passed", passed.size); putString("passed", passed.joinToString(",")) })
+    } catch (error: Throwable) {
+      finish(Activity.RESULT_CANCELED, Bundle().apply { putString("Error", error.stackTraceToString()); putString("passed", passed.joinToString(",")) })
+    }
+  }
+}
