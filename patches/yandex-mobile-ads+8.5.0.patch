@@ -0,0 +1,80 @@
+package com.yandexmobileads.rewarded
+
+/**
+ * The SDK callback commits earned evidence before crossing the asynchronous JS bridge.
+ * Storage is injected so crash/retry behavior can be tested without an Android runtime.
+ * A failed commit retains evidence in memory for another attempt; a process death while
+ * native storage itself cannot write is outside the durable-recovery guarantee.
+ */
+internal class RewardJournal(
+    persisted: Map<String, String>,
+    private val stampEarned: (String) -> String = { it },
+    private val write: (Map<String, String>) -> Boolean,
+) {
+    // Prepared ads from a previous process cannot deliver another SDK callback.
+    // They are unknown, never earned. Existing earned evidence and acknowledgments stay.
+    private val entries = persisted.filterKeys { !it.startsWith("p:") && !it.startsWith("i:") }.toMutableMap()
+    private val pendingEarned = mutableMapOf<String, String>()
+
+    @Synchronized
+    fun prepare(adId: String, rewardId: String, snapshot: String): Boolean {
+        val prepared = entries["p:$adId"]
+        if (prepared != null) return prepared == snapshot && entries["i:$adId"] == rewardId
+        val next = currentEntries()
+        if (next.containsKey("a:$rewardId") || next.containsKey("e:$rewardId")) return false
+        if (next.any { it.key.startsWith("i:") && it.value == rewardId }) return false
+        if (next.keys.count { it.startsWith("p:") } >= 32 || next.keys.count { it.startsWith("e:") } >= 128) return false
+        next["p:$adId"] = snapshot
+        next["i:$adId"] = rewardId
+        return commit(next)
+    }
+
+    @Synchronized
+    fun earned(adId: String, capturedRewardId: String? = null, capturedSnapshot: String? = null): Boolean {
+        val rewardId = entries["i:$adId"] ?: capturedRewardId ?: return false
+        if (entries.containsKey("a:$rewardId") || entries.containsKey("e:$rewardId")) return true
+        val snapshot = entries["p:$adId"] ?: capturedSnapshot ?: return false
+        if (!pendingEarned.containsKey("e:$rewardId")) pendingEarned["e:$rewardId"] = stampEarned(snapshot)
+        return commit(currentEntries())
+    }
+
+    @Synchronized
+    fun earnedSnapshots(): List<String> {
+        if (pendingEarned.isNotEmpty()) commit(currentEntries())
+        return currentEntries().toSortedMap().filterKeys { it.startsWith("e:") }.values.toList()
+    }
+
+    @Synchronized
+    fun acknowledge(rewardId: String): Boolean {
+        if (entries.containsKey("a:$rewardId")) return true
+        val next = currentEntries()
+        if (next.remove("e:$rewardId") == null) return false
+        next["a:$rewardId"] = "1"
+        val ads = next.filter { it.key.startsWith("i:") && it.value == rewardId }.keys
+        for (key in ads) {
+            next.remove("p:${key.substring(2)}")
+            next.remove(key)
+        }
+        return commit(next)
+    }
+
+    @Synchronized
+    fun discardPrepared(adId: String): Boolean {
+        val next = currentEntries()
+        if (!next.containsKey("p:$adId") && !next.containsKey("i:$adId")) return true
+        next.remove("p:$adId")
+        next.remove("i:$adId")
+        return commit(next)
+    }
+
+    private fun currentEntries(): MutableMap<String, String> = (entries + pendingEarned).toMutableMap()
+
+    private fun commit(next: Map<String, String>): Boolean {
+        val saved = try { write(next) } catch (_: Exception) { false }
+        if (!saved) return false
+        entries.clear()
+        entries.putAll(next)
+        pendingEarned.clear()
+        return true
+    }
+}
