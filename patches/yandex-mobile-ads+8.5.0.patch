+package com.yandexmobileads.rewarded
+
+/** SDK callbacks and actual Activity evidence are independent. No state here implies earned. */
+internal class RewardShowOwnership(private val abandonedRequestGraceMs: Long = 180_000) {
+    private var requestedAtMs: Long? = null
+    private var shown = false
+    private var terminal = false
+    private var observedFullscreen = false
+    private var fullscreenEnded = false
+    private var reconciled = false
+
+    fun request(nowMs: Long) { requestedAtMs = nowMs }
+    fun shown() { shown = true }
+    fun terminal() { terminal = true }
+    fun hasRequest(): Boolean = requestedAtMs != null
+    fun isTerminal(): Boolean = terminal
+
+    fun fullscreenStarted() {
+        if (!hasRequest() || terminal || reconciled) return
+        observedFullscreen = true
+        fullscreenEnded = false
+    }
+
+    fun fullscreenEnded() {
+        if (observedFullscreen) fullscreenEnded = true
+    }
+
+    fun isActive(nowMs: Long, hostResumedAndFocused: Boolean, fullscreenAlive: Boolean): Boolean {
+        val requested = requestedAtMs ?: return false
+        if (terminal) return false
+        if (fullscreenAlive) return true
+        if (reconciled) return false
+        if (!hostResumedAndFocused || nowMs - requested < abandonedRequestGraceMs) return true
+        // A requested call with no SDK shown and no Activity after the watchdog
+        // can be abandoned while the host is demonstrably resumed and focused.
+        // For a shown ad, require that its observed fullscreen Activity ended.
+        if ((!shown && !observedFullscreen) || (observedFullscreen && fullscreenEnded)) {
+            reconciled = true
+            return false
+        }
+        // Unknown same-host overlays have no reliable Activity close evidence.
+        return true
+    }
+}
