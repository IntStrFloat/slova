+package com.yandexmobileads.rewarded
+
+/** Frozen receipt v1 physical positions. Economy/order changes require a versioned migration. */
+internal object RewardReceiptContract {
+    private val wheelAmountsV1 = intArrayOf(10, 25, 50, 5, 100, 20, 200, 15)
+
+    fun acceptsWheel(sector: Int, amount: Double): Boolean =
+        sector in wheelAmountsV1.indices && amount == wheelAmountsV1[sector].toDouble()
+}
